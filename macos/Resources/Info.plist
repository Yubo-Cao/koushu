<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>FunASRBar</string>
	<key>CFBundleIdentifier</key>
	<string>com.funasr.voicebar.prototype</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>FunASR Bar</string>
	<key>CFBundleDisplayName</key>
	<string>FunASR Bar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- Accessory app: no Dock tile, never becomes the active app. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!-- Without this key macOS silently refuses to deliver microphone audio:
	     the engine runs, the taps fire, and every buffer is pure silence. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>FunASR 需要访问麦克风，用来在你按住快捷键说话时采集语音并转写成文字。</string>
</dict>
</plist>
