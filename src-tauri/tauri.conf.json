{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fun ASR Desktop",
  "version": "0.0.2",
  "identifier": "dev.yubo.fun-asr-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fun ASR Desktop",
        "url": "/",
        "width": 1240,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true
      },
      {
        "label": "voice-bar",
        "title": "Fun ASR Voice Bar",
        "url": "/bar",
        "width": 190,
        "height": 44,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/llama-funasr-cli",
      "binaries/llama-funasr-sensevoice",
      "binaries/llama-funasr-vad"
    ],
    "resources": [
      "binaries/*"
    ],
    "category": "Productivity",
    "shortDescription": "Fun-ASR desktop voice transcription.",
    "longDescription": "A local desktop wrapper for Fun-ASR with microphone capture, saved transcripts, model setup, and a floating voice bar."
  }
}
